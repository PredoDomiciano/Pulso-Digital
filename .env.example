# Senha usada para entrar em /admin. Use pelo menos 8 caracteres.
ADMIN_PASSWORD=troque-por-uma-senha-forte

# URL do site (local durante o desenvolvimento e URL da Vercel em produção).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional no deploy da Vercel quando o Blob usa OIDC.
# Para rodar localmente com `npm run dev`, você pode preencher esta variável
# com o token do seu Blob ou usar `vercel env pull` após vincular o projeto.
BLOB_READ_WRITE_TOKEN=
